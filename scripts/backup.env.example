# VAMO Backup Environment Variables (Example Template)
# Ubicación en servidor: /etc/vamo/backup.env (chmod 600)
# NUNCA ingresar valores reales en este archivo de plantilla

PG_CONTAINER=vamo-db-5vojdb
PG_USER=vamo_admin
PG_DATABASE=vamo_production
PGPASSWORD=your_secure_db_password_here

# Clave pública age (La clave privada permanece estrictamente OFFLINE)
AGE_PUBLIC_KEY=age1your_public_recipient_key_here

# Backblaze B2 Almacenamiento Offsite
B2_KEY_ID=your_b2_application_key_id
B2_APPLICATION_KEY=your_b2_application_key
B2_BUCKET=vamo-db-backups-production
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REMOTE_ALIAS=b2-vamo

BACKUP_DIR=/var/backups/vamo
LOG_DIR=/var/log/vamo
RETENTION_DAYS=14
